# compose.yaml が読む。コピーして .env を作る（git管理外）

# ライセンスキー。初回起動のときだけ使われる（署名は .foundry/data に残る）
#FOUNDRY_LICENSE_KEY=XXXX-XXXX-XXXX-XXXX-XXXX-XXXX

# 本体のzip（foundryvtt-<ビルド>.zip）の置き場。既定: ~/.cache/foundry
#FOUNDRY_CACHE=/path/to/cache

# 公開するポート。既定: 30014（300 + 世代番号）
#FVTT_PORT=30014

# 自動で開くワールド。既定: regrid-test
#FVTT_WORLD=regrid-test
